# 이 파일을 복사해 .env로 저장하고 실제 값을 채우세요. .env는 절대 git에 올리지 않습니다.

# 서버 포트 (사내망에서 http://<이 PC의 내부 IP>:PORT 로 접속)
PORT=8000

# 관리자 설정·직원 변경·담당자 등록에 사용합니다. 12자 이상의 비밀번호를 설정하세요.
# 화면의 기존 관리자 PIN은 더 이상 사용하지 않습니다.
# ADMIN_PASSWORD=

# 승인 메일/카톡에 넣을 접속 주소. 비워두면 이 PC의 내부 IP로 자동 계산합니다.
# APP_BASE_URL=http://192.168.0.10:8000

# ── 사내메일(SMTP) 발송 설정 — 전산팀에 문의해 채우세요 ──
# SMTP_HOST를 채우면 승인 요청 메일이 실제로 발송됩니다. 비워두면 발송을 건너뜁니다.
# SMTP_HOST=mail.sbs.co.kr
# SMTP_PORT=587
# SMTP_SECURE=false
# 사내망 내부 발신만 허용하는 릴레이라면 아래 인증 정보는 비워둬도 됩니다.
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="통합관제실 근무표 <noreply@sbs.co.kr>"

# ── 카카오톡 보조 알림 ──
# 이 PC에 로그인된 KakaoTalk 데스크톱 클라이언트를 자동 조작해 메시지를 보냅니다.
# 공식 API가 아니라 카카오톡 업데이트로 깨질 수 있으므로, 신뢰 채널은 항상 사내메일입니다.
# KAKAO_AUTOMATION=true
