# 이 파일을 복사해 .env로 저장하고 실제 값을 채우세요. .env는 절대 git에 올리지 않습니다.

# 서버 포트 (사내망에서 http://<이 PC의 내부 IP>:PORT 로 접속)
PORT=8000

# 관리자 설정·직원 변경·담당자 등록에 사용합니다. 12자 이상의 비밀번호를 설정하세요.
# 화면의 기존 관리자 PIN은 더 이상 사용하지 않습니다.
# ADMIN_PASSWORD=

# 승인 메일에 넣을 접속 주소. 비워두면 이 PC의 내부 IP로 자동 계산합니다.
# APP_BASE_URL=http://192.168.0.10:8000

# ── 메일 발송 설정 (Gmail 공용 계정 → 사내메일) ──
# SMTP_HOST를 채우면 승인 요청 메일과 일일 요약 메일이 실제로 발송됩니다. 비워두면 발송을 건너뜁니다.
# Gmail은 계정에 2단계 인증을 켠 뒤 '앱 비밀번호'(16자리)를 발급해 SMTP_PASS에 넣습니다.
# (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호. 평소 로그인 비밀번호는 사용할 수 없습니다.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=공용계정@gmail.com
# SMTP_PASS=
# Gmail은 발신자를 인증한 계정 주소로 고정하므로 표시 이름만 바꿀 수 있습니다.
# MAIL_FROM="통합관제실 근무표 <공용계정@gmail.com>"

# 일일 요약 메일 발송 시각 (한국 시간, HH:MM). 기본값 18:00
# DIGEST_TIME=18:00
